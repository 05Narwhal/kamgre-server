# Copy and rename this file to .env

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=ojpp
POSTGRES_USER=ojpp
POSTGRES_PASSWORD=asdfghjkl123456789

# Redis (cache)
REDIS_URL=redis://localhost

# Compiled static file storage (writable, permanent during one run)
STATIC_ROOT=data/static
# Uploaded file storage (writable, permanent across runs)
MEDIA_ROOT=data/media

# Enables the debug toolbar and error messages on the frontend
# (disable this in production)
DEBUG=True

# Sentry error reporting (leave blank to disable)
SENTRY_DSN=

# Service creds
IJPP_LOGIN=user@email.tld:password
LPP_API_KEY=API-KEY-GOES-HERE 
