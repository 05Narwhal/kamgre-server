# /etc/prestop/prestop.env — written once by bootstrap.sh, then yours to edit.
# Read by every Prestop systemd unit and by `prestop-manage`. Plain KEY=value lines only.
# After editing: sudo systemctl restart prestop-web prestop-collector prestop-push prestop-ingest

DJANGO_SETTINGS_MODULE=prestop_production
PYTHONPATH=/opt/prestop/deploy/django
PYTHONUNBUFFERED=1
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=__SECRET_KEY__
PRESTOP_DOMAIN=__DOMAIN__

# PostgreSQL over the local socket with peer auth (OS user prestop = database role prestop).
POSTGRES_HOST=/var/run/postgresql
POSTGRES_PORT=5432
POSTGRES_DB=prestop
POSTGRES_USER=prestop
POSTGRES_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379/1

STATIC_ROOT=/var/lib/prestop/static
MEDIA_ROOT=/var/lib/prestop/media
DATA_DIR=/var/lib/prestop/tmp
PRESTOP_GTFS_DIR=/var/lib/prestop/gtfs

# Cloudflare adds the visitor's country; the API uses it to suggest Slovenian or English.
PRESTOP_TRUSTED_COUNTRY_HEADER=CF-IPCountry
# Gated until the release checks in docs/superpowers/plans pass.
PRESTOP_INSANE_MODE=false
SENTRY_DSN=

# Web Push: update.sh generates the VAPID key pair below on the first deploy (prestop-manage vapid_keys).
# Keep the private key here only; changing it unsubscribes every phone.
PRESTOP_VAPID_SUBJECT=mailto:push@kamgre.si

# 2 OCPUs: two workers with threads. Each worker keeps its own upstream caches.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Egress guard (every 5 min): refuse new visitors above EGRESS_BUSY_GB or when the month runs ahead of
# its pace; stop all public traffic at EGRESS_LIMIT_GB (capped at 9000; Oracle bills above 10000 GB).
EGRESS_LIMIT_GB=8000
EGRESS_BUSY_GB=6000
# API load shedding (prestop_api/traffic.py): requests a minute per visitor, visitors in 15 minutes and
# API output in a rolling hour before new visitors are refused. People already using the app keep working.
PRESTOP_TRAFFIC_PER_MINUTE=300
PRESTOP_TRAFFIC_MAX_ACTIVE=3000
PRESTOP_TRAFFIC_HOURLY_MB=30000

# Nightly database backups: local copies kept this many days.
BACKUP_KEEP_DAYS=7
# Optional off-server copy with rclone, e.g. r2:prestop-backups (config in /etc/prestop/rclone.conf).
BACKUP_RCLONE_REMOTE=
