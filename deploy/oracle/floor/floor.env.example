# Optional overrides for the utilization floor: copy to /etc/prestop/floor.env, then
#   sudo systemctl restart prestop-floor
# Oracle reclaims an Always Free A1 instance only when CPU (95th percentile), network AND
# memory all stay under 20% for 7 days. 25% leaves a margin above that line.
FLOOR_CPU_TARGET=25
FLOOR_MEM_TARGET=25
# Seconds between measurements.
FLOOR_INTERVAL=2
# Upper bounds: burner duty per core, and memory ballast as a share of RAM.
FLOOR_CPU_MAX_DUTY=60
FLOOR_MEM_MAX_SHARE=35
# The ballast is released whenever available memory drops below this share of RAM.
FLOOR_MEM_RESERVE=15
# How often a summary goes to the journal.
FLOOR_REPORT_SECONDS=300
